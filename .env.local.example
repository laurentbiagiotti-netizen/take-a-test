# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OBLIGATOIRE : toutes les actions d'examen passent par le serveur avec cette clé.
# Ne jamais l'exposer au navigateur (pas de préfixe NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# URL publique exacte (sert au calcul des hash SEB, aux liens d'invitation, à l'anti-CSRF)
APP_URL=https://exam.cybersup.ai
# Nombre de reverse proxys de confiance devant l'appli (Vercel/Traefik/Nginx = 1)
TRUSTED_PROXY_HOPS=1

# --- Safe Exam Browser (global, en plus des clés réglées par test) ---
# SEB_ENFORCE=true impose SEB à TOUS les examens.
SEB_ENFORCE=false
SEB_CONFIG_KEY=
SEB_BROWSER_EXAM_KEY=

# --- Tâche planifiée /api/cron/maintenance (32 caractères minimum) ---
CRON_SECRET=

# --- API v1 : appels par minute et par clé ---
API_RATE_LIMIT=120

# --- Sécurité renforcée ---
# Clé maîtresse (32 octets, 64 caractères hex) qui chiffre les secrets de signature
# des clés d'API. À générer avec : openssl rand -hex 32
API_SECRETS_KEY=
# Réseaux autorisés à accéder à l'administration (vide = tous). Ex. réseau de l'école + Tailscale.
ADMIN_ALLOWED_CIDRS=
